{
  "Server": {
    "DataDir": "./data",
    "LiveDir": "./data/live",
    "CamerasFile": "../../deploy/cameras.dev.json"
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": {
            "type": "Serilog.Formatting.Display.MessageTemplateTextFormatter, Serilog",
            "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
          }
        }
      }
    ]
  }
}
